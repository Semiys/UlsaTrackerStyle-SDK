    {
      "id": 6,
      "title": "Динамика событий · по дням",
      "type": "timeseries",
      "description": "Каждая точка — количество за день UTC в выбранном периоде. Дни без событий показаны нулями. Первый и последний день могут быть неполными. Все события включают открытия экранов, нажатия и успешные действия. Нажмите название ряда в легенде, чтобы выделить его.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ulsatracker-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ulsatracker-clickhouse"
          },
          "queryType": "sql",
          "format": 0,
          "rawSql": "SELECT toDateTime(toStartOfDay(occurred_at, 'UTC'), 'UTC') AS time,\ncount() AS \"Все события\", countIf(name = 'screen_view') AS \"Открытия экранов\",\ncountIf(name = 'button_click') AS \"Нажатия кнопок\", countIf(name = 'action_success') AS \"Успешные действия\"\nFROM app.events FINAL WHERE project_id = 'lab3-demo' AND $__timeFilter(occurred_at)\nGROUP BY time ORDER BY time WITH FILL\nFROM toDateTime(toStartOfDay($__fromTime, 'UTC'), 'UTC')\nTO toDateTime(toStartOfDay($__toTime, 'UTC'), 'UTC') + INTERVAL 1 DAY STEP INTERVAL 1 DAY"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#0097A7"
          },
          "noValue": "Нет событий",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 7,
            "spanNulls": false,
            "showPoints": "always",
            "pointSize": 6,
            "axisLabel": "Количество",
            "axisPlacement": "left",
            "axisSoftMax": 2,
            "axisBorderShow": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "none",
          "decimals": 0,
          "min": 0
        },
        "overrides": [
