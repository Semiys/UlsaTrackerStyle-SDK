    {
      "id": 13,
      "title": "Сравнение с предыдущим периодом",
      "type": "timeseries",
      "description": "Две линии общего количества событий по дням UTC. Предыдущий период сдвинут на число календарных дней выбранного периода (7, 30 или 90 для быстрых кнопок) и совмещён по дням на графике. Последний день обоих периодов ограничен одинаковым временем UTC. Это сравнение количества принятых событий, а не числа пользователей.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ulsatracker-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ulsatracker-clickhouse"
          },
          "queryType": "sql",
          "format": 0,
          "rawSql": "WITH $__fromTime AS range_from, $__toTime AS range_to,\ndateDiff('day', toDate(range_from, 'UTC'), toDate(range_to, 'UTC')) + 1 AS shift_days,\naddDays(range_from, -shift_days) AS previous_from, addDays(range_to, -shift_days) AS previous_to\nSELECT toDateTime(toStartOfDay(if(occurred_at >= range_from, occurred_at, addDays(occurred_at, shift_days)), 'UTC'), 'UTC') AS time,\ncountIf(occurred_at >= range_from AND occurred_at <= range_to) AS \"Выбранный период\",\ncountIf(occurred_at >= previous_from AND occurred_at <= previous_to) AS \"Предыдущий период\"\nFROM app.events FINAL WHERE project_id = 'lab3-demo'\nAND ((occurred_at >= range_from AND occurred_at <= range_to) OR (occurred_at >= previous_from AND occurred_at <= previous_to))\nGROUP BY time ORDER BY time WITH FILL\nFROM toDateTime(toStartOfDay(range_from, 'UTC'), 'UTC')\nTO toDateTime(toStartOfDay(range_to, 'UTC'), 'UTC') + INTERVAL 1 DAY STEP INTERVAL 1 DAY"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#0097A7"
          },
          "noValue": "Нет событий",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 3,
            "spanNulls": false,
            "showPoints": "always",
            "pointSize": 6,
            "axisLabel": "Количество",
            "axisPlacement": "left",
            "axisSoftMax": 2,
            "axisBorderShow": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "none",
          "decimals": 0,
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Выбранный период"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0097A7"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Предыдущий период"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9A60B4"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": false
        }
      }
    },
    {
      "id": 14,
      "title": "Карта активности · дни и часы UTC",
      "type": "table",
      "description": "Строка — день недели, столбец — час UTC (00 означает 00:00–00:59). В ячейке сумма принятых событий за весь выбранный период, не среднее за день. Пустые часы равны нулю. Цвет: 0 — без заливки, 1–4 — светлый, 5–9 — средний, 10–49 — насыщенный, от 50 — тёмный. На узком экране прокручивайте сетку по горизонтали.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ulsatracker-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ulsatracker-clickhouse"
          },
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT multiIf(day.number = 0, 'Пн', day.number = 1, 'Вт', day.number = 2, 'Ср', day.number = 3, 'Чт', day.number = 4, 'Пт', day.number = 5, 'Сб', 'Вс') AS \"День / час UTC\",\nifNull(buckets.h00, 0) AS \"00\",\nifNull(buckets.h01, 0) AS \"01\",\nifNull(buckets.h02, 0) AS \"02\",\nifNull(buckets.h03, 0) AS \"03\",\nifNull(buckets.h04, 0) AS \"04\",\nifNull(buckets.h05, 0) AS \"05\",\nifNull(buckets.h06, 0) AS \"06\",\nifNull(buckets.h07, 0) AS \"07\",\nifNull(buckets.h08, 0) AS \"08\",\nifNull(buckets.h09, 0) AS \"09\",\nifNull(buckets.h10, 0) AS \"10\",\nifNull(buckets.h11, 0) AS \"11\",\nifNull(buckets.h12, 0) AS \"12\",\nifNull(buckets.h13, 0) AS \"13\",\nifNull(buckets.h14, 0) AS \"14\",\nifNull(buckets.h15, 0) AS \"15\",\nifNull(buckets.h16, 0) AS \"16\",\nifNull(buckets.h17, 0) AS \"17\",\nifNull(buckets.h18, 0) AS \"18\",\nifNull(buckets.h19, 0) AS \"19\",\nifNull(buckets.h20, 0) AS \"20\",\nifNull(buckets.h21, 0) AS \"21\",\nifNull(buckets.h22, 0) AS \"22\",\nifNull(buckets.h23, 0) AS \"23\"\nFROM numbers(7) AS day LEFT JOIN (\nSELECT toDayOfWeek(toTimeZone(occurred_at, 'UTC')) AS weekday,\ncountIf(toHour(occurred_at, 'UTC') = 0) AS h00,\ncountIf(toHour(occurred_at, 'UTC') = 1) AS h01,\ncountIf(toHour(occurred_at, 'UTC') = 2) AS h02,\ncountIf(toHour(occurred_at, 'UTC') = 3) AS h03,\ncountIf(toHour(occurred_at, 'UTC') = 4) AS h04,\ncountIf(toHour(occurred_at, 'UTC') = 5) AS h05,\ncountIf(toHour(occurred_at, 'UTC') = 6) AS h06,\ncountIf(toHour(occurred_at, 'UTC') = 7) AS h07,\ncountIf(toHour(occurred_at, 'UTC') = 8) AS h08,\ncountIf(toHour(occurred_at, 'UTC') = 9) AS h09,\ncountIf(toHour(occurred_at, 'UTC') = 10) AS h10,\ncountIf(toHour(occurred_at, 'UTC') = 11) AS h11,\ncountIf(toHour(occurred_at, 'UTC') = 12) AS h12,\ncountIf(toHour(occurred_at, 'UTC') = 13) AS h13,\ncountIf(toHour(occurred_at, 'UTC') = 14) AS h14,\ncountIf(toHour(occurred_at, 'UTC') = 15) AS h15,\ncountIf(toHour(occurred_at, 'UTC') = 16) AS h16,\ncountIf(toHour(occurred_at, 'UTC') = 17) AS h17,\ncountIf(toHour(occurred_at, 'UTC') = 18) AS h18,\ncountIf(toHour(occurred_at, 'UTC') = 19) AS h19,\ncountIf(toHour(occurred_at, 'UTC') = 20) AS h20,\ncountIf(toHour(occurred_at, 'UTC') = 21) AS h21,\ncountIf(toHour(occurred_at, 'UTC') = 22) AS h22,\ncountIf(toHour(occurred_at, 'UTC') = 23) AS h23\nFROM app.events FINAL WHERE project_id = 'lab3-demo' AND $__timeFilter(occurred_at)\nGROUP BY weekday\n) AS buckets ON buckets.weekday = day.number + 1 ORDER BY day.number"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#B2EBF2",
                "value": 1
              },
              {
                "color": "#4DD0E1",
                "value": 5
              },
              {
                "color": "#0097A7",
                "value": 10
              },
              {
                "color": "#006064",
                "value": 50
              }
            ]
          },
          "custom": {
            "align": "center",
            "width": 42,
            "filterable": false,
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "День / час UTC"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              },
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
