    {
      "id": 7,
      "title": "Типы событий",
      "type": "piechart",
      "description": "Доля каждого типа в общем количестве событий выбранного периода. Точное количество и доля указаны в легенде.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ulsatracker-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
