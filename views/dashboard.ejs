<% if (dashboardProvider !== 'grafana') { %>
<%- include('dashboard-tables') %>
<% } else { %>
<%- include('partials/head', { title: 'Статистика' }) %>
<main class="dashboard-main grafana-main">
  <% if (saved) { %><p class="success-message" role="status">Событие сохранено. Панель обновится автоматически в течение 30 секунд.</p><% } %>
  <section class="stats-header">
    <div><p class="eyebrow">Ваш проект</p><h1>Статистика приложения</h1><p class="muted"><%= projectName %> · местное время</p></div>
    <div class="controls"><button class="button secondary" id="export-csv" type="button" data-export-url="/dashboard/export.csv">Скачать CSV</button><button class="button secondary" id="export-json" type="button" data-export-format="json" data-export-url="/dashboard/export.json">Скачать JSON</button><button class="button secondary" id="refresh-grafana" type="button">Обновить панель</button><a class="button secondary" id="open-grafana" href="<%= dashboardUrl %>?theme=light" target="_blank" rel="noopener noreferrer">На весь экран</a></div>
  </section>
  <%- include('partials/date-range') %>
  <%- include('partials/csv-export') %>
  <p class="muted small" id="comparison-period-note">Сравнение показывает рост или спад относительно предыдущего отрезка такой же длительности. Для анализа переходов учитываются последовательные открытия разных экранов внутри одной сессии.</p>
  <p class="muted small">Наведите на точку, чтобы увидеть значения. Нажмите название ряда в легенде, чтобы выделить его. Сессии с событиями не равны числу уникальных пользователей.</p>
  <p class="muted small" id="grafana-status" role="status">Загружается панель статистики…</p>
  <div class="grafana-frame-wrap"><iframe id="grafana-frame" class="grafana-frame" data-dashboard-url="<%= dashboardUrl %>" data-range-url="/dashboard/range" title="Статистика UlsaTrackerStyle SDK <%= labImageVersion %>" referrerpolicy="no-referrer"></iframe></div>
  <noscript><p>Откройте <a href="<%= dashboardUrl %>?theme=light">панель статистики</a> в отдельной вкладке.</p></noscript>
</main>
<%- include('partials/foot') %>
<% } %>
